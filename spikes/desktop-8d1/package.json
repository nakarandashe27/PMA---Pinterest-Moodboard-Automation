{
  "name": "pma-desktop-probe-8d1",
  "productName": "PMA Проба 8D1",
  "version": "0.0.1",
  "description": "8D.1: qualification of the installed Electron runtime for PMA",
  "author": "PMA",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron . --exit-after-probe",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.pma.probe8d1",
    "executableName": "PMA-Probe-8D1",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "worker.mjs",
      "probe-lib.mjs",
      "preload.cjs",
      "ui/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "../../design/pma-desktop-icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "../../design/pma-desktop-icon.ico",
      "uninstallerIcon": "../../design/pma-desktop-icon.ico"
    },
    "extraResources": [
      {
        "from": "../../design/pma-desktop-icon.ico",
        "to": "icon.ico"
      }
    ]
  }
}
